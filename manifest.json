{
  "manifest_version": 3,
  "name": "Firebase Auth Switcher",
  "version": "0.1.0",
  "description": "Switch between Firebase Auth Emulator users with one click",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Firebase Auth Switcher"
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
